@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isAdmin = User.IsInRole("Admin");
    var userName = UserManager.GetUserName(User) ?? "";

    var title = ViewData["Title"] as string ?? "Mini-CRM";
    var eyebrow = ViewData["Eyebrow"] as string;
    var lead = ViewData["Lead"] as string;
    var hidePageHead = ViewData["HidePageHead"] as bool? == true;

    // Navigation : une seule source pour le dock (desktop), le rail (tablette),
    // la barre d'onglets et la feuille de menu (mobile).
    var nav = new (string Controller, string Label, string Short, string Icon, string ActiveIcon, string Group, bool AdminOnly, bool InTabbar)[]
    {
        ("Dashboard", "Tableau de bord", "Accueil", "bi-grid-1x2", "bi-grid-1x2-fill", "Pilotage", false, true),
        ("Client", "Clients", "Clients", "bi-people", "bi-people-fill", "Gestion", false, true),
        ("Contract", "Contrats", "Contrats", "bi-file-earmark-text", "bi-file-earmark-text-fill", "Gestion", false, true),
        ("User", "Utilisateurs", "Comptes", "bi-person-gear", "bi-person-fill-gear", "Administration", true, false),
        ("Sector", "Secteurs", "Secteurs", "bi-tags", "bi-tags-fill", "Administration", true, false),
        ("Audit", "Journal d'audit", "Audit", "bi-shield-check", "bi-shield-fill-check", "Administration", true, false),
    }.Where(n => !n.AdminOnly || isAdmin).ToArray();

    bool IsActive(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <partial name="_Head" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
@if (!isSignedIn)
{
    @* Page applicative consultée sans session (ex. erreur) : coquille minimale. *@
    if (IsSectionDefined("Actions")) { IgnoreSection("Actions"); }
    <body class="is-public">
    <div class="bare">
        <a class="brand" href="~/"><partial name="_Brand" /></a>
        <main id="contenu" class="bare__main page-enter">@RenderBody()</main>
    </div>
    <div class="toaster" id="toaster" role="region" aria-label="Notifications"></div>
    <script src="~/js/core.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    </body>
}
else
{
    <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <div class="aurora" aria-hidden="true"></div>

    <div class="shell">
        @* ---------- Dock (≥ 768px : rail, ≥ 1024px : complet) ---------- *@
        <aside class="dock" aria-label="Barre latérale">
            <a class="brand dock__brand" asp-controller="Dashboard" asp-action="Index" aria-label="Mini-CRM, tableau de bord">
                <partial name="_Brand" />
            </a>

            <nav class="dock__nav" aria-label="Navigation principale">
                @foreach (var group in nav.GroupBy(n => n.Group))
                {
                    <div class="dock__group">
                        <p class="dock__label">@group.Key</p>
                        <ul role="list">
                            @foreach (var item in group)
                            {
                                var active = IsActive(item.Controller);
                                <li>
                                    <a class="dock__link" href="@Url.Action("Index", item.Controller)"
                                       aria-current="@(active ? "page" : null)" data-tip="@item.Label" data-tip-pos="right">
                                        @if (active)
                                        {
                                            <span class="dock__indicator" aria-hidden="true"></span>
                                        }
                                        <i class="bi @(active ? item.ActiveIcon : item.Icon)" aria-hidden="true"></i>
                                        <span class="dock__text">@item.Label</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </nav>

            <div class="dock__footer">
                <div class="dock__user">
                    <span class="avatar avatar--round" data-hue="@Ui.Hue(userName)" aria-hidden="true">@Ui.Initials(userName)</span>
                    <div class="dock__who">
                        <p class="dock__email truncate" title="@userName">@userName</p>
                        <p class="dock__role">@(isAdmin ? "Administrateur" : "Lecture seule")</p>
                    </div>
                </div>
                <div class="dock__tools">
                    <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Activer le thème sombre" data-tip="Changer de thème" data-tip-pos="right">
                        <i class="bi bi-sun" aria-hidden="true"></i><i class="bi bi-moon-stars" aria-hidden="true"></i>
                    </button>
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
                        <button type="submit" class="icon-btn icon-btn--danger" aria-label="Se déconnecter" data-tip="Se déconnecter" data-tip-pos="right">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        @* ---------- Barre supérieure mobile (< 768px) ---------- *@
        <header class="mobilebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index" aria-label="Mini-CRM, tableau de bord"><partial name="_Brand" /></a>
            <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Activer le thème sombre">
                <i class="bi bi-sun" aria-hidden="true"></i><i class="bi bi-moon-stars" aria-hidden="true"></i>
            </button>
        </header>

        <main id="contenu" class="main page-enter" tabindex="-1">
            @if (!hidePageHead)
            {
                <header class="page-head">
                    <div class="page-head__text">
                        @if (!string.IsNullOrEmpty(eyebrow))
                        {
                            <p class="eyebrow" data-reveal="fade">@eyebrow</p>
                        }
                        <h1 class="page-head__title" data-reveal style="--reveal-index:1">@title</h1>
                        @if (!string.IsNullOrEmpty(lead))
                        {
                            <p class="page-head__lead" data-reveal style="--reveal-index:2">@lead</p>
                        }
                    </div>
                    @if (IsSectionDefined("Actions"))
                    {
                        <div class="page-head__actions" data-reveal style="--reveal-index:3">@RenderSection("Actions")</div>
                    }
                </header>
            }
            else if (IsSectionDefined("Actions"))
            {
                IgnoreSection("Actions");
            }
            @if (TempData["Success"] is string flash)
            {
                <div hidden data-flash="success">@flash</div>
            }
            @RenderBody()
        </main>

        @* ---------- Barre d'onglets mobile ---------- *@
        <nav class="tabbar" aria-label="Navigation rapide">
            @foreach (var item in nav.Where(n => n.InTabbar))
            {
                var active = IsActive(item.Controller);
                <a class="tabbar__link" href="@Url.Action("Index", item.Controller)" aria-current="@(active ? "page" : null)">
                    <i class="bi @(active ? item.ActiveIcon : item.Icon)" aria-hidden="true"></i>
                    <span>@item.Short</span>
                </a>
            }
            <button type="button" class="tabbar__link" data-dialog-open="navSheet" aria-haspopup="dialog"
                    aria-current="@(nav.Any(n => !n.InTabbar && IsActive(n.Controller)) ? "page" : null)">
                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                <span>Menu</span>
            </button>
        </nav>
    </div>

    @* ---------- Feuille de menu (mobile) ---------- *@
    <dialog class="dialog dialog--sheet" id="navSheet" aria-labelledby="navSheetTitle" data-dismissable>
        <div class="dialog__panel">
            <span class="dialog__grabber" aria-hidden="true"></span>
            <div class="dialog__header">
                <h2 class="dialog__title" id="navSheetTitle">Menu</h2>
                <button type="button" class="icon-btn" data-dialog-close aria-label="Fermer le menu"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="dialog__body">
                <nav aria-label="Toutes les sections">
                    @foreach (var group in nav.GroupBy(n => n.Group))
                    {
                        <p class="sheet-nav__label">@group.Key</p>
                        <ul role="list" class="sheet-nav">
                            @foreach (var item in group)
                            {
                                var active = IsActive(item.Controller);
                                <li>
                                    <a class="sheet-nav__link" href="@Url.Action("Index", item.Controller)" aria-current="@(active ? "page" : null)">
                                        <i class="bi @(active ? item.ActiveIcon : item.Icon)" aria-hidden="true"></i>
                                        <span>@item.Label</span>
                                        <i class="bi bi-chevron-right sheet-nav__chev" aria-hidden="true"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </nav>
                <div class="sheet-account">
                    <span class="avatar avatar--round" data-hue="@Ui.Hue(userName)" aria-hidden="true">@Ui.Initials(userName)</span>
                    <div class="min-w-0">
                        <p class="dock__email truncate">@userName</p>
                        <p class="dock__role">@(isAdmin ? "Administrateur" : "Lecture seule")</p>
                    </div>
                </div>
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
                    <button type="submit" class="btn btn--block"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Se déconnecter</button>
                </form>
            </div>
        </div>
    </dialog>

    @* ---------- Accès refusé (action réservée aux administrateurs) ---------- *@
    <dialog class="dialog dialog--modal" id="accessDenied" aria-labelledby="accessDeniedTitle" aria-describedby="accessDeniedText" data-dismissable>
        <div class="dialog__panel">
            <div class="dialog__body confirm-body">
                <div class="confirm" data-tone="info">
                    <div class="confirm__icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
                    <h2 class="confirm__title" id="accessDeniedTitle">Accès réservé</h2>
                    <p class="confirm__text" id="accessDeniedText">Cette action est réservée aux administrateurs. Vous pouvez consulter toutes les fiches, sans les modifier.</p>
                    <div class="form-actions">
                        <button type="button" class="btn btn--primary" data-dialog-close autofocus>J'ai compris</button>
                    </div>
                </div>
            </div>
        </div>
    </dialog>

    @* ---------- Modale CRUD (création, suppression) : ne se ferme pas au clic extérieur ---------- *@
    <dialog class="dialog dialog--modal" id="crudModal" aria-labelledby="crudModalTitle">
        <div class="dialog__panel">
            <div class="dialog__header">
                <h2 class="dialog__title" id="crudModalTitle"></h2>
                <button type="button" class="icon-btn" data-dialog-close aria-label="Fermer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="dialog__body" id="crudModalBody"></div>
        </div>
    </dialog>

    @* ---------- Tiroir latéral (fiche en lecture, édition) ---------- *@
    <dialog class="dialog dialog--drawer" id="crudPanel" aria-labelledby="crudPanelTitle" data-dismissable>
        <div class="dialog__panel">
            <span class="dialog__grabber" aria-hidden="true"></span>
            <div class="dialog__header">
                <h2 class="dialog__title" id="crudPanelTitle"></h2>
                <button type="button" class="icon-btn" data-dialog-close aria-label="Fermer le panneau"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="dialog__body" id="crudPanelBody"></div>
        </div>
    </dialog>

    <div class="toaster" id="toaster" role="region" aria-label="Notifications"></div>

    <script src="~/js/core.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    </body>
}
</html>
