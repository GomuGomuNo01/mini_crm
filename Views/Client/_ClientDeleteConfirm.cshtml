@model Client
@{
    var standalone = ViewData["Standalone"] as bool? == true;
    var count = Model.Contracts.Count;
}

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-ajax-form="@(standalone ? null : "")">
    <input type="hidden" asp-for="Id" />
    <div class="confirm" data-tone="danger">
        <div class="confirm__icon"><i class="bi bi-trash3" aria-hidden="true"></i></div>
        <h2 class="confirm__title">Supprimer ce client ?</h2>
        <p class="confirm__text"><strong>@Model.Name</strong> sera définitivement retiré de votre portefeuille.</p>
        @if (count > 0)
        {
            <p class="confirm__note">
                @(count == 1 ? "Son contrat associé sera aussi supprimé." : $"Ses {count} contrats associés seront aussi supprimés.")
                Cette action est irréversible.
            </p>
        }
        else
        {
            <p class="confirm__note confirm__note--muted">Aucun contrat associé. Cette action est irréversible.</p>
        }
        <div class="form-actions">
            @if (standalone)
            {
                <a asp-action="Index" class="btn">Annuler</a>
            }
            else
            {
                <button type="button" class="btn" data-dialog-close autofocus>Annuler</button>
            }
            <button type="submit" class="btn btn--danger" data-loading><i class="bi bi-trash3" aria-hidden="true"></i> Supprimer définitivement</button>
        </div>
    </div>
</form>
