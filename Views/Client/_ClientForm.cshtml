@model Client
@{
    var sectors = (ViewBag.Sectors as IReadOnlyList<string>) ?? new List<string>();
    var isEdit = Model.Id != 0;
    var action = isEdit ? "Edit" : "Create";
    var standalone = ViewData["Standalone"] as bool? == true;
}

<form asp-action="@action" asp-route-id="@(isEdit ? (int?)Model.Id : null)" method="post" class="form-grid"
      data-ajax-form="@(standalone ? null : "")" novalidate>
    <div asp-validation-summary="ModelOnly" class="callout" data-tone="danger"></div>
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
    }

    <div class="field">
        <label class="field__label" asp-for="Name">Nom du client <span class="field__req">Obligatoire</span></label>
        <div class="field__control">
            <i class="bi bi-buildings field__icon" aria-hidden="true"></i>
            <input asp-for="Name" class="input" placeholder="Ex. Boulangerie Martin" autocomplete="organization" />
            <span class="field__state" aria-hidden="true"></span>
        </div>
        <span asp-validation-for="Name" class="field__error"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="Email">Email de contact <span class="field__req">Obligatoire</span></label>
        <div class="field__control">
            <i class="bi bi-envelope field__icon" aria-hidden="true"></i>
            <input asp-for="Email" class="input" placeholder="contact@entreprise.fr" autocomplete="email" />
            <span class="field__state" aria-hidden="true"></span>
        </div>
        <span asp-validation-for="Email" class="field__error"></span>
    </div>

    <div class="field" data-sector-field>
        <label class="field__label" for="sectorSelect">Secteur d'activité <span class="field__req">Facultatif</span></label>
        <div class="field__control">
            <i class="bi bi-briefcase field__icon" aria-hidden="true"></i>
            <select id="sectorSelect" class="select" data-sector-select aria-describedby="sectorHint">
                <option value="">Aucun secteur</option>
                @foreach (var s in sectors)
                {
                    <option value="@s">@s</option>
                }
                <option value="__other__">Autre… (nouveau secteur)</option>
            </select>
        </div>
        <div class="field__control" data-sector-other hidden>
            <i class="bi bi-plus-circle field__icon" aria-hidden="true"></i>
            <input asp-for="Sector" class="input" data-sector-input placeholder="Nom du nouveau secteur" aria-label="Nom du nouveau secteur" />
            <span class="field__state" aria-hidden="true"></span>
        </div>
        <p class="field__hint" id="sectorHint">Absent de la liste ? Choisissez « Autre… » : il rejoindra le catalogue.</p>
        <span asp-validation-for="Sector" class="field__error"></span>
    </div>

    <fieldset class="field">
        <legend class="field__label">Statut</legend>
        <div class="segmented">
            @foreach (var s in Enum.GetValues<ClientStatus>())
            {
                var look = Ui.Of(s);
                <label data-tone="@look.Tone">
                    <input type="radio" asp-for="Status" value="@s" id="ClientStatus_@s" />
                    <span><i class="bi @look.Icon" aria-hidden="true"></i>@look.Label</span>
                </label>
            }
        </div>
    </fieldset>

    <div class="form-actions">
        @if (standalone)
        {
            <a asp-action="Index" class="btn btn--ghost">Annuler</a>
        }
        else
        {
            <button type="button" class="btn btn--ghost" data-dialog-close>Annuler</button>
        }
        <button type="submit" class="btn btn--primary" data-loading>
            <i class="bi bi-check-lg" aria-hidden="true"></i> @(isEdit ? "Enregistrer les modifications" : "Créer le client")
        </button>
    </div>
</form>
