@model PagedResult<Client>
@{
    var search = ViewBag.Search as string;
    var isAdmin = User.IsInRole("Admin");
    var hasSearch = !string.IsNullOrWhiteSpace(search);
}

<p class="list-meta">
    <span data-count><strong>@Ui.Plural(Model.TotalCount, "client", "clients")</strong>@(hasSearch ? $" pour « {search} »" : "")</span>
</p>

<div class="panel table-panel">
    @if (!Model.Items.Any())
    {
        <div class="empty">
            @if (hasSearch)
            {
                <div class="empty__icon"><i class="bi bi-search" aria-hidden="true"></i></div>
                <p class="empty__title">Aucun client ne correspond</p>
                <p class="empty__text">Essayez un autre nom, une partie de l'email ou un secteur.</p>
                <button type="button" class="btn btn--sm" data-reset><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Effacer la recherche</button>
            }
            else
            {
                <div class="empty__icon"><i class="bi bi-people" aria-hidden="true"></i></div>
                <p class="empty__title">Votre portefeuille est vide</p>
                <p class="empty__text">Ajoutez un premier client pour commencer à suivre ses contrats.</p>
                @if (isAdmin)
                {
                    <button type="button" class="btn btn--primary btn--sm" data-modal-url="@Url.Action("Create")" data-title="Nouveau client">
                        <i class="bi bi-person-plus" aria-hidden="true"></i> Ajouter un client
                    </button>
                }
            }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack">
                <caption class="visually-hidden">Liste des clients</caption>
                <thead>
                <tr>
                    <th scope="col">Client</th>
                    <th scope="col">Secteur</th>
                    <th scope="col">Statut</th>
                    <th scope="col" class="is-center">Contrats</th>
                    <th scope="col" class="is-end"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody data-reveal-group>
                @foreach (var c in Model.Items)
                {
                    var look = Ui.Of(c.Status);
                    var details = Url.Action("Details", new { id = c.Id });
                    <tr data-reveal="fade">
                        <td class="is-primary">
                            <div class="cell-main">
                                <span class="avatar" data-hue="@Ui.Hue(c.Name)" aria-hidden="true">@Ui.Initials(c.Name)</span>
                                <div class="cell-main__text">
                                    <button type="button" class="cell-link" data-panel-url="@details" data-title="Fiche client">@c.Name</button>
                                    <a class="cell-sub" href="mailto:@c.Email">@c.Email</a>
                                </div>
                            </div>
                        </td>
                        <td data-label="Secteur">
                            @if (string.IsNullOrEmpty(c.Sector))
                            {
                                <span class="muted">Non renseigné</span>
                            }
                            else
                            {
                                @c.Sector
                            }
                        </td>
                        <td data-label="Statut"><span class="status" data-tone="@look.Tone"><i class="bi @look.Icon" aria-hidden="true"></i>@look.Label</span></td>
                        <td data-label="Contrats" class="is-center"><span class="chip num">@c.Contracts.Count</span></td>
                        <td class="is-end is-actions">
                            <div class="row-actions">
                                <button type="button" class="icon-btn icon-btn--brand hide-sm" data-panel-url="@details" data-title="Fiche client"
                                        aria-label="Voir la fiche de @c.Name" data-tip="Voir la fiche"><i class="bi bi-eye" aria-hidden="true"></i></button>
                                @if (isAdmin)
                                {
                                    <button type="button" class="icon-btn icon-btn--brand" data-panel-url="@Url.Action("Edit", new { id = c.Id })" data-title="Modifier le client"
                                            aria-label="Modifier @c.Name" data-tip="Modifier"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    <button type="button" class="icon-btn icon-btn--danger" data-modal-url="@Url.Action("Delete", new { id = c.Id })" data-title=""
                                            aria-label="Supprimer @c.Name" data-tip="Supprimer"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                }
                                else
                                {
                                    <button type="button" class="icon-btn" data-dialog-open="accessDenied"
                                            aria-label="Modifier @c.Name (réservé aux administrateurs)" data-tip="Réservé aux admins"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    <button type="button" class="icon-btn" data-dialog-open="accessDenied"
                                            aria-label="Supprimer @c.Name (réservé aux administrateurs)" data-tip="Réservé aux admins"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <partial name="_Pager" model='new PagerModel(Model.PageNumber, Model.TotalPages, p => Url.Action("Index", new { page = p, search })!)' />
}
