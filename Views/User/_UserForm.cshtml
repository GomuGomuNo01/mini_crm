@model MiniCrm.ViewModels.CreateUserViewModel
@{
    var standalone = ViewData["Standalone"] as bool? == true;
}

<form asp-action="Create" method="post" class="form-grid" data-ajax-form="@(standalone ? null : "")" novalidate>
    <div asp-validation-summary="ModelOnly" class="callout" data-tone="danger"></div>

    <div class="field">
        <label class="field__label" asp-for="Email">Email <span class="field__req">Identifiant de connexion</span></label>
        <div class="field__control">
            <i class="bi bi-envelope field__icon" aria-hidden="true"></i>
            <input asp-for="Email" class="input" autocomplete="off" placeholder="prenom.nom@entreprise.fr" />
            <span class="field__state" aria-hidden="true"></span>
        </div>
        <span asp-validation-for="Email" class="field__error"></span>
    </div>

    <div class="field field--password">
        <label class="field__label" asp-for="Password">Mot de passe provisoire</label>
        <div class="field__control">
            <i class="bi bi-key field__icon" aria-hidden="true"></i>
            <input asp-for="Password" class="input" type="password" autocomplete="new-password" placeholder="8 caractères minimum"
                   data-password-input="pwdRules" aria-describedby="pwdRules" />
            <span class="field__state" aria-hidden="true"></span>
            <button type="button" class="reveal-pass" data-reveal-pass aria-label="Afficher le mot de passe" aria-pressed="false">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
        </div>
        <ul class="reqs" id="pwdRules" role="list" aria-label="Exigences du mot de passe">
            <li data-rule="length">8 caractères</li>
            <li data-rule="upper">1 majuscule</li>
            <li data-rule="lower">1 minuscule</li>
            <li data-rule="digit">1 chiffre</li>
        </ul>
        <span asp-validation-for="Password" class="field__error"></span>
    </div>

    <fieldset class="field">
        <legend class="field__label">Niveau d'accès</legend>
        <div class="choices choices--2">
            <label class="choice">
                <input type="radio" asp-for="Role" value="User" id="Role_User" />
                <span class="choice__card">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                    <span class="choice__title">Utilisateur</span>
                    <span class="choice__text">Consulte clients, contrats et tableau de bord.</span>
                </span>
            </label>
            <label class="choice">
                <input type="radio" asp-for="Role" value="Admin" id="Role_Admin" />
                <span class="choice__card">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span class="choice__title">Administrateur</span>
                    <span class="choice__text">Crée, modifie, supprime et gère les accès.</span>
                </span>
            </label>
        </div>
        <span asp-validation-for="Role" class="field__error"></span>
    </fieldset>

    <div class="form-actions">
        @if (standalone)
        {
            <a asp-action="Index" class="btn btn--ghost">Annuler</a>
        }
        else
        {
            <button type="button" class="btn btn--ghost" data-dialog-close>Annuler</button>
        }
        <button type="submit" class="btn btn--primary" data-loading><i class="bi bi-check-lg" aria-hidden="true"></i> Créer l'accès</button>
    </div>
</form>
