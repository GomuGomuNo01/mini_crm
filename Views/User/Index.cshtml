@model List<MiniCrm.ViewModels.UserListItem>
@{
    ViewData["Title"] = "Utilisateurs";
    ViewData["Eyebrow"] = "Administration";
    ViewData["Lead"] = "Pas d'inscription publique : c'est ici que vous ouvrez un accès, en lecture seule ou administrateur.";
}

@section Actions {
    <button type="button" class="btn btn--primary" data-modal-url="@Url.Action("Create")" data-title="Nouvel utilisateur">
        <i class="bi bi-person-plus" aria-hidden="true"></i> Créer un accès
    </button>
}

@* Rechargement de la liste après une action CRUD *@
<div data-live-filter data-target="#userList" data-url="@Url.Action("Index")" hidden></div>
<p class="visually-hidden" aria-live="polite" data-live-count></p>

<div class="results" data-busy-host data-reveal style="--reveal-index:3">
    <div class="loadbar" aria-hidden="true"></div>
    <div id="userList">
        <partial name="_UserTable" model="Model" />
    </div>
</div>
