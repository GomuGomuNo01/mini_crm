@model MiniCrm.Models.ApplicationUser

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-ajax-form>
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="confirm" data-tone="danger">
        <div class="confirm__icon"><i class="bi bi-person-x" aria-hidden="true"></i></div>
        <h2 class="confirm__title">Révoquer cet accès ?</h2>
        <p class="confirm__text"><strong>@Model.Email</strong> ne pourra plus se connecter à Mini-CRM.</p>
        <p class="confirm__note confirm__note--muted">Le compte est supprimé définitivement. Les actions passées restent visibles dans le journal d'audit.</p>
        <div class="form-actions">
            <button type="button" class="btn" data-dialog-close autofocus>Annuler</button>
            <button type="submit" class="btn btn--danger" data-loading><i class="bi bi-person-x" aria-hidden="true"></i> Supprimer le compte</button>
        </div>
    </div>
</form>
