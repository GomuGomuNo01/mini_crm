@model PagedResult<Contract>
@{
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as ContractStatus?;
    var isAdmin = User.IsInRole("Admin");
    var filtered = !string.IsNullOrWhiteSpace(search) || status != null;
    var filterText = string.Join(" · ", new[]
    {
        status is { } st ? $"{Ui.Of(st).Label.ToLower()}s" : null,
        string.IsNullOrWhiteSpace(search) ? null : $"« {search} »"
    }.Where(x => x != null));
}

<p class="list-meta">
    <span data-count><strong>@Ui.Plural(Model.TotalCount, "contrat", "contrats")</strong>@(filtered ? $" · {filterText}" : "")</span>
</p>

<div class="panel table-panel">
    @if (!Model.Items.Any())
    {
        <div class="empty">
            @if (filtered)
            {
                <div class="empty__icon"><i class="bi bi-funnel" aria-hidden="true"></i></div>
                <p class="empty__title">Aucun contrat ne correspond</p>
                <p class="empty__text">Élargissez la recherche ou affichez tous les statuts.</p>
                <button type="button" class="btn btn--sm" data-reset><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Réinitialiser les filtres</button>
            }
            else
            {
                <div class="empty__icon"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i></div>
                <p class="empty__title">Aucun contrat pour l'instant</p>
                <p class="empty__text">Créez un contrat pour suivre son montant, sa période et son échéance.</p>
                @if (isAdmin)
                {
                    <button type="button" class="btn btn--primary btn--sm" data-modal-url="@Url.Action("Create")" data-title="Nouveau contrat">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Créer un contrat
                    </button>
                }
            }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack">
                <caption class="visually-hidden">Liste des contrats</caption>
                <thead>
                <tr>
                    <th scope="col">Contrat</th>
                    <th scope="col" class="is-end">Montant</th>
                    <th scope="col">Période</th>
                    <th scope="col">Statut</th>
                    <th scope="col" class="is-end"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody data-reveal-group>
                @foreach (var c in Model.Items)
                {
                    var look = Ui.Of(c.Status);
                    var clientName = c.Client?.Name ?? "Client inconnu";
                    var details = Url.Action("Details", new { id = c.Id });
                    <tr data-reveal="fade">
                        <td class="is-primary">
                            <div class="cell-main">
                                <span class="avatar" data-hue="@Ui.Hue(clientName)" aria-hidden="true">@Ui.Initials(clientName)</span>
                                <div class="cell-main__text">
                                    <button type="button" class="cell-link" data-panel-url="@details" data-title="Fiche contrat">@c.Title</button>
                                    <button type="button" class="cell-link cell-link--sub"
                                            data-panel-url="@Url.Action("Details", "Client", new { id = c.ClientId })" data-title="Fiche client">@clientName</button>
                                </div>
                            </div>
                        </td>
                        <td data-label="Montant" class="is-end"><span class="amount">@Ui.Money(c.Amount)</span></td>
                        <td data-label="Période" class="is-wide">
                            <partial name="_Lifespan" model="c" view-data='new ViewDataDictionary(ViewData) { { "ShowDates", true } }' />
                        </td>
                        <td data-label="Statut">
                            <span class="status" data-tone="@look.Tone"><i class="bi @look.Icon" aria-hidden="true"></i>@look.Label</span>
                        </td>
                        <td class="is-end is-actions">
                            <div class="row-actions">
                                <button type="button" class="icon-btn icon-btn--brand hide-sm" data-panel-url="@details" data-title="Fiche contrat"
                                        aria-label="Voir le contrat @c.Title" data-tip="Voir la fiche"><i class="bi bi-eye" aria-hidden="true"></i></button>
                                @if (isAdmin)
                                {
                                    <button type="button" class="icon-btn icon-btn--brand" data-panel-url="@Url.Action("Edit", new { id = c.Id })" data-title="Modifier le contrat"
                                            aria-label="Modifier le contrat @c.Title" data-tip="Modifier"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    <button type="button" class="icon-btn icon-btn--danger" data-modal-url="@Url.Action("Delete", new { id = c.Id })" data-title=""
                                            aria-label="Supprimer le contrat @c.Title" data-tip="Supprimer"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                }
                                else
                                {
                                    <button type="button" class="icon-btn" data-dialog-open="accessDenied"
                                            aria-label="Modifier le contrat @c.Title (réservé aux administrateurs)" data-tip="Réservé aux admins"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    <button type="button" class="icon-btn" data-dialog-open="accessDenied"
                                            aria-label="Supprimer le contrat @c.Title (réservé aux administrateurs)" data-tip="Réservé aux admins"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <partial name="_Pager" model='new PagerModel(Model.PageNumber, Model.TotalPages, p => Url.Action("Index", new { page = p, search, status })!)' />
}
