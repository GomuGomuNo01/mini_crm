@model Contract
@{
    var look = Ui.Of(Model.Status);
    var life = Ui.LifespanOf(Model);
    var isAdmin = User.IsInRole("Admin");
    var clientName = Model.Client?.Name ?? "Client inconnu";
    var months = Math.Max(1, (int)Math.Round((Model.EndDate - Model.StartDate).TotalDays / 30.44));
}

<div class="profile">
    <span class="profile__icon" data-tone="@look.Tone" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
    <div class="min-w-0">
        <h3 class="profile__name">@Model.Title</h3>
        <div class="profile__meta">
            <span class="status" data-tone="@look.Tone"><i class="bi @look.Icon" aria-hidden="true"></i>@look.Label</span>
            @if (Model.IsExpiringSoon)
            {
                <span class="status" data-tone="alert"><i class="bi bi-alarm" aria-hidden="true"></i>Expire bientôt</span>
            }
            @if (life.IsOverdue)
            {
                <span class="status" data-tone="danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>Échéance dépassée</span>
            }
        </div>
    </div>
</div>

<div class="facts" data-reveal-group>
    <div class="fact" data-reveal>
        <span class="fact__label"><i class="bi bi-cash-stack" aria-hidden="true"></i> Montant</span>
        <span class="fact__value fact__value--big">@Ui.Money(Model.Amount)</span>
    </div>
    <div class="fact" data-reveal>
        <span class="fact__label"><i class="bi bi-person" aria-hidden="true"></i> Client</span>
        <span class="fact__value">
            <button type="button" class="cell-link" data-panel-url="@Url.Action("Details", "Client", new { id = Model.ClientId })" data-title="Fiche client">@clientName</button>
        </span>
    </div>
    <div class="fact fact--wide" data-reveal>
        <span class="fact__label"><i class="bi bi-calendar-range" aria-hidden="true"></i> Période · @months mois</span>
        <partial name="_Lifespan" model="Model" view-data='new ViewDataDictionary(ViewData) { { "ShowDates", true } }' />
    </div>
    <div class="fact" data-reveal>
        <span class="fact__label"><i class="bi bi-calendar-event" aria-hidden="true"></i> Début</span>
        <span class="fact__value">@Ui.Date(Model.StartDate)</span>
    </div>
    <div class="fact" data-reveal>
        <span class="fact__label"><i class="bi bi-calendar-check" aria-hidden="true"></i> Fin</span>
        <span class="fact__value">@Ui.Date(Model.EndDate)</span>
    </div>
</div>

<div class="form-actions">
    @if (isAdmin)
    {
        <button type="button" class="btn btn--ghost" data-modal-url="@Url.Action("Delete", "Contract", new { id = Model.Id })" data-title="">
            <i class="bi bi-trash3" aria-hidden="true"></i> Supprimer
        </button>
        <button type="button" class="btn btn--primary" data-panel-url="@Url.Action("Edit", "Contract", new { id = Model.Id })" data-title="Modifier le contrat">
            <i class="bi bi-pencil" aria-hidden="true"></i> Modifier le contrat
        </button>
    }
    else
    {
        <p class="readonly-note"><i class="bi bi-lock" aria-hidden="true"></i> Lecture seule : la modification est réservée aux administrateurs.</p>
    }
</div>
