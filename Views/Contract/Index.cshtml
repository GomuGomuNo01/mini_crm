@model PagedResult<Contract>
@{
    ViewData["Title"] = "Contrats";
    ViewData["Eyebrow"] = "Gestion";
    ViewData["Lead"] = "Montants, périodes et statuts : suivez la vie de chaque contrat jusqu'à son échéance.";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as ContractStatus?;
}

@section Actions {
    <a id="exportCsvLink" class="btn" asp-action="ExportCsv" asp-route-search="@search" asp-route-status="@status">
        <i class="bi bi-download" aria-hidden="true"></i> Exporter en CSV
    </a>
    @if (User.IsInRole("Admin"))
    {
        <button type="button" class="btn btn--primary" data-modal-url="@Url.Action("Create")" data-title="Nouveau contrat">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Créer un contrat
        </button>
    }
    else
    {
        <button type="button" class="btn btn--primary" data-dialog-open="accessDenied">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Créer un contrat
        </button>
    }
}

<form class="toolbar" role="search" data-live-filter data-target="#contractTable" data-url="@Url.Action("Index")"
      data-export-url="@Url.Action("ExportCsv")" data-export-target="#exportCsvLink"
      data-reveal style="--reveal-index:3">
    <div class="search">
        <label class="visually-hidden" for="contractSearch">Rechercher un contrat</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input id="contractSearch" type="search" name="search" value="@search" class="input" autocomplete="off"
               placeholder="Rechercher par titre ou client…" data-search-shortcut />
        <span class="search__end">
            <button type="button" class="search__clear" data-search-clear aria-label="Effacer la recherche"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            <kbd class="kbd" title="Raccourci clavier">/</kbd>
        </span>
    </div>
    <fieldset class="filter-chips">
        <legend class="visually-hidden">Filtrer par statut</legend>
        <label class="filter-chip">
            <input type="radio" name="status" value="" checked="@(status == null)" />
            <span>Tous</span>
        </label>
        @foreach (var s in Enum.GetValues<ContractStatus>())
        {
            var look = Ui.Of(s);
            <label class="filter-chip">
                <input type="radio" name="status" value="@s" checked="@(status == s)" />
                <span><i class="bi @look.Icon" aria-hidden="true"></i>@(look.Label)s</span>
            </label>
        }
    </fieldset>
</form>
<p class="visually-hidden" aria-live="polite" data-live-count></p>

<div class="results" data-busy-host data-reveal style="--reveal-index:4">
    <div class="loadbar" aria-hidden="true"></div>
    <div id="contractTable">
        <partial name="_ContractTable" model="Model" />
    </div>
</div>
