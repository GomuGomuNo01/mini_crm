@model PagedResult<MiniCrm.Models.Sector>
@{
    var search = ViewBag.Search as string;
    var hasSearch = !string.IsNullOrWhiteSpace(search);
}

<p class="list-meta">
    <span data-count><strong>@Ui.Plural(Model.TotalCount, "secteur", "secteurs")</strong>@(hasSearch ? $" pour « {search} »" : "")</span>
</p>

<div class="panel table-panel">
    @if (!Model.Items.Any())
    {
        <div class="empty">
            @if (hasSearch)
            {
                <div class="empty__icon"><i class="bi bi-search" aria-hidden="true"></i></div>
                <p class="empty__title">Aucun secteur ne correspond</p>
                <p class="empty__text">Vérifiez l'orthographe ou ajoutez ce secteur au catalogue.</p>
                <button type="button" class="btn btn--sm" data-reset><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Effacer la recherche</button>
            }
            else
            {
                <div class="empty__icon"><i class="bi bi-tags" aria-hidden="true"></i></div>
                <p class="empty__title">Le catalogue est vide</p>
                <p class="empty__text">Ajoutez des secteurs pour les proposer dans les fiches clients.</p>
                <button type="button" class="btn btn--primary btn--sm" data-modal-url="@Url.Action("Create")" data-title="Nouveau secteur">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter un secteur
                </button>
            }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack">
                <caption class="visually-hidden">Catalogue des secteurs</caption>
                <thead>
                <tr>
                    <th scope="col">Secteur</th>
                    <th scope="col" class="is-end"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody data-reveal-group>
                @foreach (var s in Model.Items)
                {
                    <tr data-reveal="fade">
                        <td class="is-primary">
                            <div class="cell-main">
                                <span class="avatar avatar--round" data-hue="@Ui.Hue(s.Name)" aria-hidden="true"><i class="bi bi-tag"></i></span>
                                <span class="cell-title">@s.Name</span>
                            </div>
                        </td>
                        <td class="is-end is-actions">
                            <div class="row-actions">
                                <button type="button" class="icon-btn icon-btn--brand" data-modal-url="@Url.Action("Edit", new { id = s.Id })" data-title="Renommer le secteur"
                                        aria-label="Renommer @s.Name" data-tip="Renommer"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                <button type="button" class="icon-btn icon-btn--danger" data-modal-url="@Url.Action("Delete", new { id = s.Id })" data-title=""
                                        aria-label="Supprimer @s.Name" data-tip="Supprimer"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <partial name="_Pager" model='new PagerModel(Model.PageNumber, Model.TotalPages, p => Url.Action("Index", new { page = p, search })!)' />
}
