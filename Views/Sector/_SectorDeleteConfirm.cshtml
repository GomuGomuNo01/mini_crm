@model MiniCrm.Models.Sector
@{
    var clientCount = ViewBag.ClientCount as int? ?? 0;
}

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-ajax-form>
    <input type="hidden" asp-for="Id" />
    <div class="confirm" data-tone="danger">
        <div class="confirm__icon"><i class="bi bi-trash3" aria-hidden="true"></i></div>
        <h2 class="confirm__title">Retirer ce secteur ?</h2>
        <p class="confirm__text"><strong>@Model.Name</strong> ne sera plus proposé dans les fiches clients.</p>
        @if (clientCount > 0)
        {
            <p class="confirm__note">
                @Ui.Plural(clientCount, "client utilise", "clients utilisent") ce secteur : leur fiche le conservera tel quel.
            </p>
        }
        else
        {
            <p class="confirm__note confirm__note--muted">Aucun client n'utilise ce secteur.</p>
        }
        <div class="form-actions">
            <button type="button" class="btn" data-dialog-close autofocus>Annuler</button>
            <button type="submit" class="btn btn--danger" data-loading><i class="bi bi-trash3" aria-hidden="true"></i> Retirer du catalogue</button>
        </div>
    </div>
</form>
