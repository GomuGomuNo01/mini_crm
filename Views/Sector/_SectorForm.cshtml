@model MiniCrm.Models.Sector
@{
    var isEdit = Model.Id != 0;
    var action = isEdit ? "Edit" : "Create";
}

<form asp-action="@action" asp-route-id="@(isEdit ? (int?)Model.Id : null)" method="post" class="form-grid" data-ajax-form novalidate>
    <div asp-validation-summary="ModelOnly" class="callout" data-tone="danger"></div>
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="field">
        <label class="field__label" asp-for="Name">Nom du secteur <span class="field__req">Obligatoire</span></label>
        <div class="field__control">
            <i class="bi bi-tag field__icon" aria-hidden="true"></i>
            <input asp-for="Name" class="input" placeholder="Ex. Agroalimentaire" autocomplete="off" />
            <span class="field__state" aria-hidden="true"></span>
        </div>
        @if (isEdit)
        {
            <p class="field__hint">Les clients rattachés à ce secteur seront mis à jour automatiquement.</p>
        }
        <span asp-validation-for="Name" class="field__error"></span>
    </div>

    <div class="form-actions">
        <button type="button" class="btn btn--ghost" data-dialog-close>Annuler</button>
        <button type="submit" class="btn btn--primary" data-loading>
            <i class="bi bi-check-lg" aria-hidden="true"></i> @(isEdit ? "Renommer le secteur" : "Ajouter au catalogue")
        </button>
    </div>
</form>
